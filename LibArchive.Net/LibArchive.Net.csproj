<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- TargetFrameworks set by Directory.Build.props (auto-generated from SDK version) -->
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <!-- Allow unsafe code for UTF-8 string handling and LibraryImportAttribute -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RuntimeIdentifiers>win-x86;win-x64;win-arm64;linux-x64;linux-musl-x64;linux-arm;linux-musl-arm;linux-arm64;linux-musl-arm64;osx-x64;osx-arm64</RuntimeIdentifiers>

    <!-- AOT and Trimming Support (for .NET 6+) -->
    <IsAotCompatible Condition="$([MSBuild]::GetTargetFrameworkIdentifier('$(TargetFramework)')) != '.NETStandard'">true</IsAotCompatible>
    <IsTrimmable Condition="$([MSBuild]::GetTargetFrameworkIdentifier('$(TargetFramework)')) != '.NETStandard'">true</IsTrimmable>
    <EnableTrimAnalyzer Condition="$([MSBuild]::GetTargetFrameworkIdentifier('$(TargetFramework)')) != '.NETStandard'">true</EnableTrimAnalyzer>
    <EnableAotAnalyzer Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net8.0'))">true</EnableAotAnalyzer>

    <!-- Package Metadata -->
    <PackageLicenseExpression>BSD-2-Clause</PackageLicenseExpression>
    <PackageId>LibArchive.Net</PackageId>
    <PackageTags>Compression;Libarchive;Tar;Zip;7Zip;Rar;AOT;NativeAOT;Trimming</PackageTags>
    <Description>Read and write zip, 7-Zip, tar and many other archive and compression formats with the native libarchive library, included for Windows (x86, x64, arm64), Linux (x64, arm, arm64; glibc and musl) and macOS (x64, arm64). Supports Native AOT and trimming on .NET 10 and later.</Description>
    <Authors>James A Sutherland</Authors>
    <Copyright>Copyright 2022-2024</Copyright>
    <Title>LibArchive.Net</Title>
    <DebugType>embedded</DebugType>
    <PackageProjectUrl>https://github.com/jas88/libarchive.net/</PackageProjectUrl>
    <RepositoryUrl>https://github.com/jas88/libarchive.net.git</RepositoryUrl>

    <!-- MinVer Configuration -->
    <MinVerMinimumMajorMinor>0.2</MinVerMinimumMajorMinor>
    <MinVerTagPrefix>v</MinVerTagPrefix>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="MinVer" Version="8.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="System.Buffers" Version="4.6.1" />
    <PackageReference Include="System.Memory" Version="4.6.3" />
  </ItemGroup>
  <ItemGroup>
    <!-- Include native libraries in NuGet package -->
    <Content Include="runtimes\**\*.*">
      <Pack>true</Pack>
      <PackagePath>runtimes\%(RecursiveDir)%(Filename)%(Extension)</PackagePath>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Visible>false</Visible>
    </Content>

    <!-- Include the .targets file in the NuGet package so it's automatically imported -->
    <None Include="LibArchive.Net.targets">
      <Pack>true</Pack>
      <PackagePath>build\$(PackageId).targets;buildTransitive\$(PackageId).targets;build\net462\$(PackageId).targets;buildTransitive\net462\$(PackageId).targets</PackagePath>
    </None>

    <!-- Licence notices for the third-party code linked into the native libraries, at the package root -->
    <None Include="..\THIRD-PARTY-NOTICES.txt">
      <Pack>true</Pack>
      <PackagePath>\</PackagePath>
      <Visible>false</Visible>
    </None>
  </ItemGroup>

  <!-- Expose native libraries as content that flows to consuming projects -->
  <ItemGroup>
    <ContentWithTargetPath Include="runtimes\**\*.*" Condition="Exists('runtimes')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <TargetPath>%(RecursiveDir)%(Filename)%(Extension)</TargetPath>
    </ContentWithTargetPath>
  </ItemGroup>

  <!--
    Warn, when packing only, if the native library of any runtime the package supports
    is missing from runtimes/: such a package installs anywhere but fails at run time on
    those runtimes. The list is what the "Assemble native runtimes" step of
    .github/workflows/build.yml puts there, so keep the two in step. It is a warning, not
    an error, because a package packed locally for testing legitimately has only the
    libraries built on that machine (see "Testing a package locally" in native/BUILD.md).
  -->
  <Target Name="_LibArchiveWarnMissingNativeLibraries" BeforeTargets="GenerateNuspec">
    <ItemGroup>
      <_LibArchiveNativeLibrary Include="linux-x64;linux-musl-x64;linux-arm;linux-musl-arm;linux-arm64;linux-musl-arm64" Library="libarchive.so" />
      <_LibArchiveNativeLibrary Include="osx-x64;osx-arm64" Library="libarchive.dylib" />
      <_LibArchiveNativeLibrary Include="win-x86;win-x64;win-arm64" Library="archive.dll" />
      <_LibArchiveMissingNativeLibrary Include="@(_LibArchiveNativeLibrary)"
                                       Condition="!Exists('$(MSBuildProjectDirectory)/runtimes/%(_LibArchiveNativeLibrary.Identity)/native/%(_LibArchiveNativeLibrary.Library)')" />
    </ItemGroup>
    <Warning Code="LIBARCHIVENET001"
             Condition="'@(_LibArchiveMissingNativeLibrary)' != ''"
             Text="The package has no native library for @(_LibArchiveMissingNativeLibrary->'%(Identity)', ', '), so it will not work on those runtimes. Before packing, put runtimes/&lt;rid&gt;/native/libarchive.so (linux-*), libarchive.dylib (osx-*) or archive.dll (win-*) in the project directory for each runtime: see &quot;Testing a package locally&quot; in native/BUILD.md." />
  </Target>
</Project>
