<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <!-- TargetFrameworks set by Directory.Build.props (auto-generated from SDK version) -->
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
        <GenerateDocumentationFile>false</GenerateDocumentationFile>
        <ImplicitUsings>enable</ImplicitUsings>
        <!-- Run the net462 tests as a 64-bit process. This does not copy archive.dll next to the
             test assembly: it stays in runtimes\win-x64\native, where LibArchive.Net loads it from. -->
        <PlatformTarget Condition="'$(TargetFramework)' == 'net462'">x64</PlatformTarget>
        <!-- Enable Microsoft Testing Platform via NUnit3TestAdapter -->
        <UseTestingPlatform>true</UseTestingPlatform>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
        <PackageReference Include="NUnit" Version="5.0.0" />
        <PackageReference Include="NUnit3TestAdapter" Version="6.3.1" />
        <PackageReference Include="NUnit.Analyzers" Version="4.15.0" />
        <PackageReference Include="coverlet.collector" Version="10.1.1" Condition="'$(TargetFramework)' != 'net462'" />
    </ItemGroup>
    <ItemGroup Condition="'$(UseLocalPackage)' == 'true'">
      <!-- Reference the NuGet package for realistic testing -->
      <!-- Version is passed from CI via LibArchiveNetVersion property -->
      <PackageReference Include="LibArchive.Net" Version="$(LibArchiveNetVersion)" />
    </ItemGroup>
    <ItemGroup Condition="'$(UseLocalPackage)' != 'true'">
      <!-- Fall back to project reference for local development -->
      <ProjectReference Include="..\LibArchive.Net\LibArchive.Net.csproj" />
    </ItemGroup>

    <ItemGroup>
        <None Update="7ztest.7z" CopyToOutputDirectory="PreserveNewest" />
        <!-- Written by the reference lzop tool; see LzopTests.cs -->
        <None Update="lzoptest.tar.lzo" CopyToOutputDirectory="PreserveNewest" />
        <!-- Written by the reference compression tools; see CompressedFileTests.cs -->
        <None Update="rawtest*" CopyToOutputDirectory="PreserveNewest" />
        <!-- Written by GNU gzip and bsdtar; see MtreeTextTests.cs -->
        <None Update="mtreetest*" CopyToOutputDirectory="PreserveNewest" />
        <!-- Written by Info-ZIP, Python, bsdtar, GNU tar, p7zip and hdiutil; see NameFixtureTests.cs -->
        <None Update="nametest-*" CopyToOutputDirectory="PreserveNewest" />
        <None Update="rartest.part00001.rar" CopyToOutputDirectory="PreserveNewest" />
        <None Update="rartest.part00002.rar" CopyToOutputDirectory="PreserveNewest" />
        <None Update="rartest.part00003.rar" CopyToOutputDirectory="PreserveNewest" />
        <None Update="rartest.part00004.rar" CopyToOutputDirectory="PreserveNewest" />
        <None Update="test-password.zip" CopyToOutputDirectory="PreserveNewest" />
        <!-- Written by the bsdtar of macOS; see XarTests.cs -->
        <None Update="xartest.xar" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>
</Project>
